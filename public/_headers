# Netlify caching strategy (Vite + React Router):
# - index.html sem cache (evita problema de chunk antigo / 404 após deploy)
# - assets versionados (/assets/* com hash) com cache longo e immutable (economiza bandwidth/créditos)
# - service worker sem cache (sempre pegar a versão mais nova)

/index.html
  Cache-Control: no-cache, no-store, must-revalidate

/booking/*
  Cache-Control: no-cache, no-store, must-revalidate

/*
  Cache-Control: no-cache, no-store, must-revalidate

/sw.js
  Cache-Control: no-cache, no-store, must-revalidate

/manifest.json
  Cache-Control: public, max-age=0, must-revalidate

/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Caso exista JS/CSS na raiz (menos comum no Vite), também cachear
/*.js
  Cache-Control: public, max-age=31536000, immutable

/*.css
  Cache-Control: public, max-age=31536000, immutable

# Imagens estáticas podem cachear por 7 dias (se você trocar a imagem, o navegador revalida depois)
*.png
  Cache-Control: public, max-age=604800

*.jpg
  Cache-Control: public, max-age=604800

*.jpeg
  Cache-Control: public, max-age=604800

*.svg
  Cache-Control: public, max-age=604800